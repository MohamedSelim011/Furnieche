generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ENGINEER
  ADMIN
}

enum ProjectRole {
  EDITOR
  VIEWER
}

enum PortalLinkType {
  OWNER
  VISITOR
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
  DELAYED
}

enum ProjectCategory {
  RESIDENTIAL
  COMMERCIAL
  HOSPITALITY
  OTHER
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum PaymentType {
  REQUEST
  DEPOSIT
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  name                    String?
  avatarUrl               String?
  role                    UserRole  @default(ENGINEER)
  companyId               String?
  company                 Company?  @relation(fields: [companyId], references: [id])
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  lastNotificationsReadAt DateTime?

  projects       Project[]
  comments       Comment[]
  auditLogs      AuditLog[]
  projectMembers ProjectMember[]
  chatReads      ChatRead[]
  uploadedFiles  ProjectFile[]

  @@map("users")
}

// ─── Company ──────────────────────────────────────────────────────────────────

model Company {
  id        String   @id @default(uuid())
  name      String
  email     String?
  logoUrl   String?
  plan      String   @default("business")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  projects Project[]
  invites  CompanyInvite[]

  @@map("companies")
}

// ─── Company Invites (Team) ──────────────────────────────────────────────────

model CompanyInvite {
  id         String    @id @default(uuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email      String
  role       UserRole  @default(ENGINEER)
  token      String    @unique @default(uuid())
  acceptedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@map("company_invites")
}

// ─── Project ──────────────────────────────────────────────────────────────────

model Project {
  id               String          @id @default(uuid())
  name             String
  category         ProjectCategory @default(RESIDENTIAL)
  status           ProjectStatus   @default(ACTIVE)
  clientName       String
  clientEmail      String
  location         String?
  startDate        DateTime?
  estimatedEndDate DateTime?
  progressPercent  Int             @default(0)
  coverUrl         String?
  budget           Float?

  engineerId String
  engineer   User     @relation(fields: [engineerId], references: [id])
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folders          ProjectFolder[]
  updates          ProjectUpdate[]
  accessTokens     AccessToken[]
  auditLogs        AuditLog[]
  payments         Payment[]
  members          ProjectMember[]
  contractAnalyses ContractAnalysis[]
  imageEdits       ImageEdit[]
  comments         Comment[]
  chatReads        ChatRead[]

  @@map("projects")
}

// ─── Project Members (sharing within a company) ──────────────────────────────

model ProjectMember {
  id            String      @id @default(uuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          ProjectRole @default(VIEWER)
  canViewBudget Boolean     @default(false)
  // When true (the default — preserves existing members' access as-is), this
  // member can see every folder. When false, access is limited to exactly
  // the folders listed in folderAccess (which may be empty).
  allFolders    Boolean     @default(true)
  createdAt     DateTime    @default(now())

  folderAccess ProjectMemberFolder[]

  @@unique([projectId, userId])
  @@map("project_members")
}

// ─── Per-folder access grants (only used when a member's allFolders is false) ─

model ProjectMemberFolder {
  id        String        @id @default(uuid())
  memberId  String
  member    ProjectMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  folderId  String
  folder    ProjectFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([memberId, folderId])
  @@map("project_member_folders")
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model Payment {
  id            String        @id @default(uuid())
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type          PaymentType
  status        PaymentStatus @default(PENDING)
  amount        Float
  description   String?
  screenshotUrl String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("payments")
}

// ─── Project Folders (phases: Contract, Design, Site, ...) ──────────────────

model ProjectFolder {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  order           Int
  isDefault       Boolean  @default(false)
  progressPercent Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Folders can nest — a null parentId means this is a main/root folder.
  parentId String?
  parent   ProjectFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children ProjectFolder[] @relation("FolderTree")

  files        ProjectFile[]
  updates      ProjectUpdate[]
  memberAccess ProjectMemberFolder[]

  @@map("project_steps")
}

// ─── Project Files (documents/photos inside a folder) ───────────────────────

model ProjectFile {
  id               String             @id @default(uuid())
  folderId         String
  folder           ProjectFolder      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name             String
  url              String
  type             MediaType          @default(DOCUMENT)
  sizeBytes        Int?
  progressPercent  Int                @default(0)
  // Manual sort position inside the folder (engineer drags to reorder)
  order            Int                @default(0)
  uploadedById     String?
  uploadedBy       User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  contractAnalyses ContractAnalysis[]
  comments         Comment[]
  imageEdits       ImageEdit[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("project_files")
}

// ─── Project Updates ──────────────────────────────────────────────────────────

model ProjectUpdate {
  id          String         @id @default(uuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folderId    String?
  folder      ProjectFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  title       String
  description String?
  location    String?
  category    String?
  isPublished Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  media    Media[]
  comments Comment[]

  @@map("project_updates")
}

// ─── Media ────────────────────────────────────────────────────────────────────

model Media {
  id        String        @id @default(uuid())
  updateId  String
  update    ProjectUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  url       String
  type      MediaType     @default(IMAGE)
  filename  String?
  sizeBytes Int?
  createdAt DateTime      @default(now())

  @@map("media")
}

// ─── Comments ─────────────────────────────────────────────────────────────────

// Project chat message. Optionally about a project update or a folder file
// (shown with that photo/update in the chat). Client messages have no authorId.
model Comment {
  id          String         @id @default(uuid())
  updateId    String?
  update      ProjectUpdate? @relation(fields: [updateId], references: [id], onDelete: Cascade)
  fileId      String?
  file        ProjectFile?   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  // Set on all new messages; older update comments are found via their update
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Set when the message is a client's AI photo edit request
  imageEditId String?        @unique
  imageEdit   ImageEdit?     @relation(fields: [imageEditId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?          @relation(fields: [authorId], references: [id])
  clientName  String?
  clientEmail String?
  body        String
  isEdited    Boolean        @default(false)
  createdAt   DateTime       @default(now())

  @@index([projectId, createdAt])
  @@map("comments")
}

// ─── Access Tokens (Client Portal) ───────────────────────────────────────────

model AccessToken {
  id         String         @id @default(uuid())
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  token      String         @unique @default(uuid())
  // OWNER link sees everything including the wallet; VISITOR sees everything
  // except the wallet. Defaults to OWNER so already-issued links (created
  // before this field existed) keep behaving exactly as they do today.
  type       PortalLinkType @default(OWNER)
  isActive   Boolean        @default(true)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime       @default(now())

  @@map("access_tokens")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

enum ContractAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// AI analysis of a contract file, produced by the contract-service (Python).
model ContractAnalysis {
  id                String                 @id @default(uuid())
  projectId         String
  project           Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileId            String
  file              ProjectFile            @relation(fields: [fileId], references: [id], onDelete: Cascade)
  status            ContractAnalysisStatus @default(PENDING)
  result            Json?
  error             String?
  model             String?
  requestedById     String?
  // Set when the engineer applies extracted dates/budget, and separately when
  // payment requests are created, so payments can't be created twice.
  appliedAt         DateTime?
  paymentsCreatedAt DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([fileId])
  @@map("contract_analyses")
}

model AuditLog {
  id        String   @id @default(uuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

enum ImageEditStatus {
  PROCESSING
  COMPLETED
  FAILED
}

// A client's AI edit request on a folder photo ("make the wall more creamy").
model ImageEdit {
  id            String          @id @default(uuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileId        String
  file          ProjectFile     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  prompt        String
  status        ImageEditStatus @default(PROCESSING)
  resultUrl     String?
  error         String?
  clientName    String?
  // Which portal link asked for it (used for the daily edit limit)
  accessTokenId String?
  // Set when the engineer saves the result into the folder as a new file
  savedFileId   String?
  comment       Comment?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([fileId])
  @@index([accessTokenId, createdAt])
  @@map("image_edits")
}

// When a team member last opened a project's chat (drives unread dots).
model ChatRead {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())

  @@id([userId, projectId])
  @@map("chat_reads")
}
