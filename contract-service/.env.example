# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Must match CONTRACT_SERVICE_TOKEN in the Next.js app's .env
SERVICE_TOKEN=

# Where results are sent. From Docker on your machine, the Next.js dev server is host.docker.internal
CALLBACK_URL=http://host.docker.internal:3000/api/internal/contract-analysis

# Supabase storage host that contract files are downloaded from
ALLOWED_FILE_HOST=your-project-ref.supabase.co

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# MAX_FILE_MB=30
# MAX_CONCURRENT_JOBS=3
